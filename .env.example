# Canonical origin, no trailing slash. Must match your primary domain exactly.
# Required in production — the build throws without it, because canonicals,
# robots.txt, sitemap.xml and all OG image URLs derive from it.
NEXT_PUBLIC_APP_URL=https://your-domain.com

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional. GA4 measurement ID — analytics is skipped entirely when unset.
NEXT_PUBLIC_GA_ID=

# Optional. Content value from the Google Search Console HTML-tag verification
# method; a durable second verification alongside DNS/file methods.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
